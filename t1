`timescale 1ns/1ps
// PicoRV32 RV32I + local EBR + UART RX/TX + SW LEDs + debug snapshot.
// AXI master (from native memory bridge) accesses original I2C slave at 0x4000_xxxx.
// RISC-V CPU remains alive when PCIe owns the I2C AXI slave; UART controls owner.
module picorv32_cpu_axil_uart #(
 parameter integer CLK_HZ=125000000,
 parameter integer BAUD=115200,
 parameter integer RAM_WORDS=8192,
 parameter integer INITIAL_CPU_OWNER=1,
 parameter FIRMWARE_HEX="firmware.hex"
)(
 input wire clk,input wire resetn,input wire uart_rx,
 input wire [3:0] dev_irq, input wire cpu_owner,
 output reg requested_cpu,
 output wire [7:0] leds,output wire uart_tx,output wire cpu_trap,
 output reg [31:0] dbg_event_q,output reg [31:0] dbg_aux_q,
 output reg dbg_toggle, output reg dbg_pulse,
 output wire [15:0] m_awaddr,output wire m_awvalid,input wire m_awready,
 output wire [31:0] m_wdata,output wire [3:0] m_wstrb,
 output wire m_wvalid,input wire m_wready,
 input wire [1:0] m_bresp,input wire m_bvalid,output wire m_bready,
 output wire [15:0] m_araddr,output wire m_arvalid,input wire m_arready,
 input wire [31:0] m_rdata,input wire [1:0] m_rresp,
 input wire m_rvalid,output wire m_rready
);
 wire mem_valid,mem_instr;
 reg mem_ready;
 wire [31:0] mem_addr,mem_wdata;
 wire [3:0] mem_wstrb;
 reg [31:0] mem_rdata;
 wire ram_sel=(mem_addr < RAM_WORDS*4);
 wire axil_sel=(mem_addr[31:16]==16'h4000);
 wire local_sel=(mem_addr[31:8]==24'h100000);
 wire local_wr=mem_valid && mem_ready && (|mem_wstrb);
 wire local_rd=mem_valid && mem_ready && !(|mem_wstrb);
 wire [31:0] axil_rdata;
 wire axil_ready;
 reg ram_ready;
 reg [31:0] ram_rdata;
 reg [31:0] ram [0:RAM_WORDS-1];
 reg [31:0] uptime_cycles;
 reg [7:0] leds_sw;
 assign leds={cpu_trap|leds_sw[7],leds_sw[6:0]};
 always @(posedge clk or negedge resetn)
   if(!resetn) uptime_cycles<=0;
   else uptime_cycles<=uptime_cycles+1;
 initial $readmemh(FIRMWARE_HEX,ram);
 picorv32 #(
   .ENABLE_IRQ(0),.ENABLE_MUL(1),.ENABLE_DIV(1),
   .COMPRESSED_ISA(0),.PROGADDR_RESET(32'h00000000),
   .STACKADDR(RAM_WORDS*4)
 ) u_cpu (
   .clk(clk),.resetn(resetn),.trap(cpu_trap),
   .mem_valid(mem_valid),.mem_instr(mem_instr),
   .mem_ready(mem_ready),.mem_addr(mem_addr),
   .mem_wdata(mem_wdata),.mem_wstrb(mem_wstrb),.mem_rdata(mem_rdata),
   .irq(32'd0),.eoi(),.pcpi_wr(1'b0),.pcpi_rd(32'd0),
   .pcpi_wait(1'b0),.pcpi_ready(1'b0)
 );
 // RAM memory array/port intentionally has NO reset to support EBR inference.
 // The RAM contents are initialized using $readmemh during FPGA configuration.
 // RAM ready is separately reset; the 1-cycle read is synchronous.
 always @(posedge clk) begin
   if(mem_valid && ram_sel && !ram_ready) begin
     ram_rdata <= ram[mem_addr[14:2]];
     if(mem_wstrb[0]) ram[mem_addr[14:2]][ 7: 0] <= mem_wdata[ 7: 0];
     if(mem_wstrb[1]) ram[mem_addr[14:2]][15: 8] <= mem_wdata[15: 8];
     if(mem_wstrb[2]) ram[mem_addr[14:2]][23:16] <= mem_wdata[23:16];
     if(mem_wstrb[3]) ram[mem_addr[14:2]][31:24] <= mem_wdata[31:24];
   end
 end
 always @(posedge clk or negedge resetn) begin
   if(!resetn) ram_ready <= 1'b0;
   else ram_ready <= mem_valid && ram_sel && !ram_ready;
 end
 native_to_axil_master u_bridge (
   .clk(clk),.resetn(resetn),
   .mem_valid(mem_valid && axil_sel && cpu_owner),.mem_addr(mem_addr),
   .mem_wdata(mem_wdata),.mem_wstrb(mem_wstrb),
   .mem_ready(axil_ready),.mem_rdata(axil_rdata),
   .m_awaddr(m_awaddr),.m_awvalid(m_awvalid),.m_awready(m_awready),
   .m_wdata(m_wdata),.m_wstrb(m_wstrb),.m_wvalid(m_wvalid),.m_wready(m_wready),
   .m_bresp(m_bresp),.m_bvalid(m_bvalid),.m_bready(m_bready),
   .m_araddr(m_araddr),.m_arvalid(m_arvalid),.m_arready(m_arready),
   .m_rdata(m_rdata),.m_rresp(m_rresp),.m_rvalid(m_rvalid),.m_rready(m_rready)
 );
 wire tx_ready,rx_valid,rx_overrun,rx_framing_error;
 wire [7:0] rx_data;
 // RX FIFO pop occurs only on a completed read of RXDATA (same
 // accepted native memory transaction whose old head byte CPU receives).
 wire rx_pop = local_sel && mem_valid && mem_ready &&
               (mem_wstrb == 4'b0000) &&
               (mem_addr == 32'h10000018);
 wire tx_write=local_sel && mem_valid && (|mem_wstrb) && mem_addr==32'h10000004;
 wire tx_fire=tx_write && tx_ready;
 uart_tx_mmio #(.CLK_HZ(CLK_HZ),.BAUD(BAUD)) u_uart_tx(
   .clk(clk),.resetn(resetn),.tx_fire(tx_fire),
   .tx_data(mem_wdata[7:0]),.tx_ready(tx_ready),.uart_tx(uart_tx)
 );
 uart_rx_byte #(.CLK_HZ(CLK_HZ),.BAUD(BAUD)) u_uart_rx(
   .clk(clk),.resetn(resetn),.serial_rx(uart_rx),
   .pop(rx_pop),
   .data(rx_data),.valid(rx_valid),.overrun(rx_overrun),
   .framing_error(rx_framing_error)
 );
 always @(*) begin
   mem_ready=0;mem_rdata=32'hBAD0_ADD0;
   if(ram_sel) begin mem_ready=ram_ready;mem_rdata=ram_rdata;end
   else if(axil_sel) begin
     mem_ready=cpu_owner ? axil_ready : mem_valid;
     mem_rdata=cpu_owner ? axil_rdata : 32'hDEAD_0001;
   end else if(local_sel) begin
     mem_ready=mem_valid && (!tx_write || tx_ready);
     case(mem_addr)
       32'h10000000:mem_rdata=CLK_HZ;
       32'h10000004:mem_rdata={31'd0,tx_ready};
       32'h10000008:mem_rdata={31'd0,tx_ready};
       32'h1000000C:mem_rdata=uptime_cycles;
       32'h10000010:mem_rdata={24'd0,leds};
       32'h10000018:mem_rdata={24'd0,rx_data};
       32'h1000001C:mem_rdata={29'd0,rx_framing_error,rx_overrun,rx_valid};
       32'h10000020:mem_rdata={31'd0,requested_cpu};
       32'h10000024:mem_rdata={31'd0,cpu_owner};
       32'h10000028:mem_rdata={28'd0,dev_irq};
       32'h10000030:mem_rdata=dbg_event_q;
       32'h10000034:mem_rdata=dbg_aux_q;
       32'h10000038:mem_rdata={31'd0,dbg_toggle};
       default:mem_rdata=32'hBAD0_ADD0;
     endcase
   end else if(mem_valid) mem_ready=1;
 end
 always @(posedge clk or negedge resetn) begin
   if(!resetn) begin
     leds_sw<=0;requested_cpu<=INITIAL_CPU_OWNER;dbg_event_q<=0;
     dbg_aux_q<=0;dbg_toggle<=0;dbg_pulse<=0;
   end else begin
     dbg_pulse<=0;
     if(local_sel && local_wr) begin
       case(mem_addr)
         32'h10000010:leds_sw<=mem_wdata[7:0];
         32'h10000020:requested_cpu<=mem_wdata[0];
         32'h10000030:begin
            dbg_event_q<=mem_wdata;dbg_toggle<=~dbg_toggle;dbg_pulse<=1;
         end
         32'h10000034:dbg_aux_q<=mem_wdata;
       endcase
     end
   end
 end
endmodule
